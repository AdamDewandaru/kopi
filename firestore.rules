rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Staf = akun dengan custom claim role == 'staff'.
    // Claim hanya bisa diberikan lewat Admin SDK (functions/scripts/set-staff.js).
    function isStaff() {
      return request.auth != null && request.auth.token.get('role', '') == 'staff';
    }

    // Alur status yang sah untuk staf. 'rejected' hanya ditulis Cloud Function.
    function validTransition(from, to) {
      return (from == 'pending'   && to in ['preparing', 'cancelled'])
          || (from == 'preparing' && to in ['ready', 'cancelled'])
          || (from == 'ready'     && to in ['done', 'cancelled']);
    }

    // Menu publik; hanya admin (console / Admin SDK) yang boleh mengubah.
    match /products/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Pesanan:
    //  - pelanggan: buat & baca miliknya sendiri;
    //  - staf: baca semua, dan ubah HANYA status sesuai alur di atas, hanya untuk
    //    pesanan yang harganya sudah diverifikasi server (priceVerified == true).
    // Harga otoritatif diverifikasi Function `verifyOrderPrices` (functions/index.js).
    match /orders/{id} {
      allow read: if request.auth != null
                  && (resource.data.userId == request.auth.uid || isStaff());
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['userId','items','total','status','paymentMethod','note','createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentMethod == 'cashier'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && request.resource.data.total is int
        && request.resource.data.total > 0
        && request.resource.data.total <= 100000000
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 200
        && request.resource.data.createdAt == request.time;
      allow update: if isStaff()
        && resource.data.get('priceVerified', false) == true
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'statusUpdatedAt', 'statusUpdatedBy'])
        && validTransition(resource.data.status, request.resource.data.status)
        && request.resource.data.statusUpdatedAt == request.time
        && request.resource.data.statusUpdatedBy == request.auth.uid;
      allow delete: if false;
    }

    // Token notifikasi (FCM) perangkat milik user sendiri (P1.8).
    // ID dokumen = token FCM. Hanya `platform` dan `updatedAt` yang boleh ada, sehingga
    // `set(..., merge: true)` yang sama bisa dipakai untuk membuat maupun menyegarkan token.
    // Dokumen induk `users/{uid}` tetap tertutup. Pembacaan token oleh Cloud Function
    // memakai Admin SDK (tidak terkena aturan); seluruh subkoleksi dihapus saat akun dihapus.
    match /users/{uid}/tokens/{token} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && token.size() >= 20 && token.size() <= 512
        && request.resource.data.keys().hasOnly(['platform', 'updatedAt'])
        && request.resource.data.platform in ['android', 'ios']
        && request.resource.data.updatedAt == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
